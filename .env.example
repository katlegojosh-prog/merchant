# Copy to .env (never commit real values).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry → Project Settings → Client Keys (DSN). Optional: monitoring is a no-op without it.
VITE_SENTRY_DSN=

# Knock, Stripe and the Supabase service role are NOT Vite variables.
# Secret/service-role keys must NEVER carry a VITE_ prefix: Vite inlines every
# VITE_* variable into the client bundle at build time, so a prefixed secret
# would ship to every visitor. Keep them unprefixed and server-side only.
# They are Worker secrets (Sites → Secrets, or `sites_set_secret`):
#   SUPABASE_URL, SUPABASE_ANON_KEY
#   KNOCK_API_KEY, KNOCK_WORKFLOW_KEY
#   STRIPE_SECRET_KEY, STRIPE_PRICE_ID, STRIPE_WEBHOOK_SECRET
#   SUPABASE_SERVICE_ROLE_KEY
